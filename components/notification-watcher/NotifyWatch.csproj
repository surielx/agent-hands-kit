<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- windows10.0.22621.0 target pulls in the C#/WinRT projection needed for
         Windows.UI.Notifications.Management (UserNotificationListener). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>notifywatch</AssemblyName>
    <RootNamespace>NotifyWatch</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>2.0.0</Version>
    <Description>Notification Center watcher v2: captures Windows toast notifications via UserNotificationListener and appends them as JSONL for the AI watchers.</Description>
  </PropertyGroup>

</Project>
